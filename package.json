{
  "name": "kvm-share",
  "version": "0.1.0",
  "private": true,
  "description": "Prototipo de mouse/teclado/clipboard compartidos entre Mac y Windows en la misma red local",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node -e \"process.platform==='darwin'&&require('child_process').execSync('bash scripts/postinstall.sh',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "koffi": "^3.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
